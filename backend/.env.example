# =======================================
# Configuration de l'environnement
# =======================================

# Environnement d'exécution (development, production, test)
NODE_ENV=development

# Port du serveur
PORT=5000

# URL de connexion PostgreSQL
# Format: postgresql://utilisateur:motdepasse@hote:port/nombasedonnees
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dedouanement_db

# Origins autorisés pour CORS (en production, spécifier les URLs exact)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Secret JWT (à générer une chaîne aléatoire sécurisée)
JWT_SECRET=your_jwt_secret_key_change_in_production_with_strong_value

# Durée d'expiration du token JWT
JWT_EXPIRE=7d

# Configuration optionnelle pour les logs
LOG_LEVEL=info
